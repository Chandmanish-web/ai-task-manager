# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in your key.
#
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# `.env` is git-ignored so your key never gets committed.
# ---------------------------------------------------------------------------

# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Starts with "sk-ant-". Leave blank to run the app with AI features disabled —
# task CRUD still works, and the AI endpoints return a clear "no key" message.
ANTHROPIC_API_KEY=

# Which model the AI features call.
#   auto  -> ask the API which models your key can access and pick the best one
#            (recommended: never breaks when a model ID is retired)
#   or pin an exact ID, e.g. claude-sonnet-4-6-20260515
ANTHROPIC_MODEL=auto

# Preference order used when ANTHROPIC_MODEL=auto. First family with an
# available model wins. Sonnet is the sweet spot for this app: fast enough for
# quick capture, strong enough for planning and code generation.
ANTHROPIC_MODEL_PREFERENCE=sonnet,opus,haiku

# Max tokens per response. The AI Studio generator needs plenty of room because
# it writes complete HTML documents; 8000 is a sane floor for that feature.
ANTHROPIC_MAX_TOKENS=8000

# Where the SQLite file lives. The default puts taskmanager.db in backend/.
# DATABASE_URL=sqlite:///./taskmanager.db

# Frontend origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
